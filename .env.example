# ローカル: このファイルをコピーして .env.local を作成し、値を埋める。
# Vercel: Dashboard → Settings → Environment Variables で同じ名前を設定する。

# --- 必須（Neon PostgreSQL）---
# Neon Dashboard → Connection string（pooled 推奨）
DATABASE_URL=

# --- 必須（Vercel Blob / 画像アップロード）---
# Vercel Dashboard → Storage → blind-dram → Connect → BLOB_READ_WRITE_TOKEN
BLOB_READ_WRITE_TOKEN=

# --- 任意（API レート制限。未設定ならミドルウェアは制限をスキップ）---
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# --- 廃止（Supabase 移行済み。Vercel から削除してよい）---
# NEXT_PUBLIC_SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
