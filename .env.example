# ローカル: このファイルをコピーして .env.local を作成し、値を埋める。
# Vercel: Dashboard → Settings → Environment Variables で同じ名前を設定する。

# --- 必須（Supabase）---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# API ルート専用。ブラウザに渡さないこと。NEXT_PUBLIC_ プリフィックスは付けない。
SUPABASE_SERVICE_ROLE_KEY=

# --- 任意（API レート制限。未設定ならミドルウェアは制限をスキップ）---
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
